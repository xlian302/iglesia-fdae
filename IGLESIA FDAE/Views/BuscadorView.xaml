<Page x:Class="IGLESIA_FDAE.Views.BuscadorView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0A0A0A">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="🔍 Buscador de la Biblia"
            FontSize="32"
            FontWeight="Bold"
            Foreground="White"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,20,0,10">

            <TextBox
                x:Name="TxtBusqueda"
                Width="450"
                Height="40"
                FontSize="18"
                KeyDown="TxtBusqueda_KeyDown"
                VerticalContentAlignment="Center"/>

            <Button
                Content="Buscar"
                Width="120"
                Height="40"
                Margin="10,0,0,0"
                Click="Buscar_Click"/>

        </StackPanel>

        <TextBlock Grid.Row="2"
                   x:Name="TxtAyuda"
                   Foreground="#666666"
                   FontSize="14"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Text="Ejemplo: 2 corintios 1:1  |  juan 3:16  |  genesis 1  |  también puedes buscar por texto"/>

        <Border Grid.Row="3"
                Background="#161616"
                CornerRadius="10"
                Padding="10">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel
                    x:Name="PanelResultados">
                </StackPanel>
            </ScrollViewer>

        </Border>

    </Grid>

</Page>