<Page x:Class="IGLESIA_FDAE.Views.HimnarioView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0A0A0A">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="🎵 Himnario"
            FontSize="32"
            FontWeight="Bold"
            Foreground="White"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,20,0,20">

            <TextBox
                Width="300"
                Height="40"
                FontSize="18"
                Margin="0,0,10,0"/>

            <Button
                Content="Buscar"
                Width="120"
                Height="40"/>

        </StackPanel>

        <Border Grid.Row="2"
                Background="#161616"
                CornerRadius="10"
                Padding="15">

            <ScrollViewer>

                <TextBlock
                    x:Name="TxtHimno"
                    Foreground="White"
                    FontSize="22"
                    TextWrapping="Wrap"/>

            </ScrollViewer>

        </Border>

    </Grid>

</Page>