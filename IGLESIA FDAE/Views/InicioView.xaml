<Page x:Class="IGLESIA_FDAE.Views.InicioView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#111111">

    <Grid>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <Image Source="/Assets/logo.png"
                   Width="180"
                   Height="180"
                   Margin="0,0,0,20"/>

            <TextBlock Text="IGLESIA EVANGÉLICA MISIONERA FDAE"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <Button Content="📖 Biblia"
                    Width="300"
                    Height="60"
                    Margin="0,10"
                    Click="Biblia_Click"/>

            <Button Content="🎵 Himnario"
                    Width="300"
                    Height="60"
                    Margin="0,10"
                    Click="Himnario_Click"/>

            <Button Content="🔍 Buscador"
                    Width="300"
                    Height="60"
                    Margin="0,10"
                    Click="Buscador_Click"/>

        </StackPanel>

    </Grid>

</Page>