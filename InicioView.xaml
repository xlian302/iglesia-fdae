<Page x:Class="IGLESIA_FDAE.Views.InicioView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#111111">

    <Grid>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <TextBlock
                Text="IGLESIA EVANGÉLICA MISIONERA FDAE"
                FontSize="32"
                Foreground="White"
                FontWeight="Bold"
                Margin="0,0,0,40"
                HorizontalAlignment="Center"/>

            <WrapPanel HorizontalAlignment="Center">

                <Button
                    x:Name="BtnBiblia"
                    Width="220"
                    Height="220"
                    Margin="10"
                    FontSize="26"
                    Content="📖&#10;BIBLIA"/>

                <Button
                    x:Name="BtnHimnos"
                    Width="220"
                    Height="220"
                    Margin="10"
                    FontSize="26"
                    Content="🎵&#10;HIMNARIO"/>

                <Button
                    x:Name="BtnBuscador"
                    Width="220"
                    Height="220"
                    Margin="10"
                    FontSize="26"
                    Content="🔍&#10;BUSCADOR"/>

            </WrapPanel>

        </StackPanel>

    </Grid>

</Page>